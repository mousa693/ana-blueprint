# Pick ONE provider. With no key at all the app runs in demo mode.

# Google Gemini — free tier, good vision. Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# OpenRouter — one key, many models (some free, ids end in ":free"): https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.5-flash

# Anthropic Claude: https://console.anthropic.com
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# Any OpenAI-compatible API (OpenAI, Groq, Together, ...)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# Ollama — runs on your own machine, totally free: https://ollama.com  (ollama pull qwen2.5vl)
# PROVIDER=ollama
# OLLAMA_MODEL=qwen2.5vl
# OLLAMA_URL=http://localhost:11434

# Force a provider instead of auto-detecting: gemini | openrouter | anthropic | openai | ollama | demo
# PROVIDER=
# PORT=3000
# RATE_LIMIT_PER_MIN=15
