# ANA — environment for docker compose (`cp .env.example .env`).
# Every variable the server reads is listed here. Never commit your real .env.
#
# Values are read by the app container (env_file) and by compose itself for the
# ${...} substitutions in docker-compose.yml.

# ── Required ────────────────────────────────────────────────────────────────
# Signs session cookies. At least 16 characters; use 48+ random bytes.
# Changing it logs everyone out. Generate one with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
#   # or: openssl rand -base64 48 | tr -d '\n'
ANA_SECRET_KEY=change-me-run-the-command-above

# Development mode: allows a missing secret (random per process) and cookies
# without the Secure flag. Keep 0 for anything reachable by other people.
ANA_DEV=0

# ── Public address (set both behind a domain / TLS proxy) ──────────────────
# The exact origin browsers use: scheme://host[:port], no trailing slash.
# Enables the Origin check for it, Secure cookies and HSTS (https), and adds
# its host to the Host allowlist automatically.
# ANA_PUBLIC_ORIGIN=https://ana.example.com

# Host header allowlist (comma list, ports ignored). Keep "localhost": the
# container HEALTHCHECK calls /healthz with Host: localhost.
ANA_ALLOWED_HOSTS=localhost,127.0.0.1

# Client IP for the per-IP rate limits (log-in/sign-up). The app derives it
# itself, trusting only what YOUR proxy wrote (docs/DEPLOY.md#client-ip):
#   ANA_CLIENT_IP_HEADER  a header the edge proxy SETS, overwriting any client
#                         value — Fly.io: fly-client-ip
#   ANA_TRUSTED_PROXY_HOPS=N  the N-th X-Forwarded-For entry from the RIGHT
#                         (the one your proxy appended) — Render, the caddy
#                         profile, nginx: 1. Leftmost entries are client-written.
#   neither               the TCP peer (nothing in front of the app).
# ANA_CLIENT_IP_HEADER=
# ANA_TRUSTED_PROXY_HOPS=1
#
# uvicorn's own proxy handling: keep 127.0.0.1. NEVER "*" — uvicorn would take
# the leftmost (forgeable) X-Forwarded-For entry as the client.
FORWARDED_ALLOW_IPS=127.0.0.1

# ── Storage ─────────────────────────────────────────────────────────────────
# SQLAlchemy URL. Default: SQLite on the /data volume.
# ANA_DATABASE_URL=sqlite:////data/ana.db
#
# Postgres (`docker compose --profile postgres up -d`): set a password and
# point the app at the bundled server. postgres:// and postgresql:// URLs are
# rewritten to the psycopg 3 driver automatically.
# POSTGRES_PASSWORD=change-me-too
# ANA_DATABASE_URL=postgresql://ana:change-me-too@postgres:5432/ana
#
# MCMG memory shards: always one SQLite file on the /data volume (also with
# Postgres). docker-compose.yml pins it to /data/shards.db.
# ANA_SHARD_DB=/data/shards.db

# ── Model (optional) ────────────────────────────────────────────────────────
# Without a key every journey runs deterministically (offline).
# ANTHROPIC_API_KEY=sk-ant-...
# auto = on when a key is present; on / off force it.
ANA_USE_LLM=auto

# ── Access & budgets ────────────────────────────────────────────────────────
ANA_ALLOW_SIGNUPS=1
# Comma list; when set, sign-up requires one of these codes. Example:
#   python3 -c 'import secrets; print(",".join(secrets.token_urlsafe(9) for _ in range(5)))'
# ANA_INVITE_CODES=
# Per-user turns per UTC day (each journey's first scene and each onboarding
# submission count as one too).
ANA_DAILY_CYCLES_PER_USER=60
# Global model CALLS per UTC day (every request to the model: scenes,
# interpretation, NPC lines, onboarding, safety screens, debriefs); beyond it
# everything runs deterministically. This is your spend cap:
# cost/day ~= this x your average cost per call (a turn is ~2-3 calls).
ANA_DAILY_LLM_CYCLES_TOTAL=2000
# Open (active or paused) journeys per user.
ANA_MAX_ACTIVE_JOURNEYS=3

# ── Operational extras (not in the spec table; defaults are fine) ──────────
# Turns before a journey closes on its own.
# ANA_MAX_CYCLES=30
# Journeys kept warm in memory (LRU); others are restored from their snapshot.
# ANA_RUNTIME_CACHE_SIZE=64
# Turns per user per minute.
# ANA_ACT_PER_MINUTE=30
# Model safety second opinions per user per hour; beyond it the deterministic
# safety floor alone screens that person's text (it always runs).
# ANA_SAFETY_MODEL_PER_HOUR=60
# Concurrent argon2 password hashes (19 MiB each). Requests that wait >2 s for
# a slot get 503 + Retry-After. 2 fits a 512 MB VM.
# ANA_PASSWORD_HASH_CONCURRENCY=2

# ── docker compose only ─────────────────────────────────────────────────────
# Interface/port the app is published on (keep 127.0.0.1 unless you have a
# reason; the caddy profile does not need it published at all).
# ANA_BIND=127.0.0.1
# ANA_PORT=8000
# Domain for the caddy profile (DNS A/AAAA records must point at this host).
# ANA_DOMAIN=ana.example.com
# Image tag compose builds/runs.
# ANA_IMAGE=ana:local
